    v4 -> v5 [id=4, particle="phi"];
    v6 -> v3 [id=5, particle="phi"];
    v4 -> v1 [id=6, particle="phi"];
    v2 -> v3 [id=7, particle="phi"];
    v1 -> v2 [id=8, particle="phi"];
}
